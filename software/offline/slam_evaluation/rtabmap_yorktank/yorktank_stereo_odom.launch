<launch>

  <node pkg="rtabmap_odom"
        type="stereo_odometry"
        name="stereo_odometry"
        output="screen">

    <param name="frame_id" value="camera"/>
    <param name="odom_frame_id" value="odom"/>

    <param name="approx_sync" value="true"/>
    <param name="queue_size" value="100"/>
    <param name="Stereo/MaxDisparity" value="1024"/>

    <param name="publish_tf" value="true"/>

    <remap from="left/image_rect"
           to="/camera/left/image_rect_underwater"/>

    <remap from="right/image_rect"
           to="/camera/right/image_rect_underwater"/>

    <remap from="left/camera_info"
           to="/yorktank/left/camera_info"/>

    <remap from="right/camera_info"
           to="/yorktank/right/camera_info"/>

    <remap from="odom"
           to="/rtabmap_stereo_odom"/>

  </node>

</launch>
